---
import Layout from '../layouts/Layout.astro';
import { getCoins } from "../api/api.ts";
import CryptoSelect from "../components/CryptoSelect.vue";
import CryptoData from "../components/CryptoData.svelte";

import '../styles/global.css';

const coins = await getCoins();
---

<Layout>
	<CryptoSelect coins={coins} client:load />
	<CryptoData client:visible />
</Layout>
